#!/usr/bin/env python3
"""Indexed pick-and-place cycle, driven either by ground truth (perception:=gt) or by the vision stack
(perception:=vision: /togsim/pick_candidates + /togsim/tray_state).

Same motion/vacuum logic as demo_pick_gt; the only difference is where candidates and trays come from.
"""

import json
import math
from collections import deque
import threading
import time

import rclpy
import yaml
from ament_index_python.packages import get_package_share_directory
from geometry_msgs.msg import PoseStamped
from rclpy.action import ActionClient
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.executors import MultiThreadedExecutor
from rclpy.node import Node
from sensor_msgs.msg import JointState
from std_msgs.msg import Float64, String
from tf2_msgs.msg import TFMessage

from togsim_msgs.action import ExecuteMotion
from togsim_msgs.msg import MotionSegment, PickCandidateArray, TrayState, VacuumState
from togsim_msgs.srv import SetVacuum
from togsim_task.diagnostics import GroundTruthEval
from togsim_task.scheduler import (
    BELT_Z,
    PRODUCT_FITS,
    PRODUCT_HEIGHT,
    PRODUCT_LENGTH,
    REACH_MAX,
    REACH_MIN,
    CycleConfig,
    candidate_reason,
    free_pocket,
    nearest_branch,
    reachable,
)
from togsim_task.trays import TraySpec



def yaw_of(q):
    return math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))


def tilt_of(q):
    return math.acos(max(-1.0, min(1.0, 1.0 - 2.0 * (q.x * q.x + q.y * q.y))))


def seg(type_, x=0.0, y=0.0, z=0.0, yaw=0.0, tilt=0.0, via_speed=0.0, dwell=0.0, frame="world", tracked="", settle=0.0):
    s = MotionSegment()
    s.type = type_
    s.settle_tolerance_m = float(settle)  # TRACK_CART: 0 = the motion server's default
    s.pose = PoseStamped()
    s.pose.header.frame_id = tracked or frame  # TRACK_CART: the pose lives in the moving frame
    s.pose.pose.position.x, s.pose.pose.position.y, s.pose.pose.position.z = float(x), float(y), float(z)
    s.pose.pose.orientation.z = math.sin(yaw / 2)
    s.pose.pose.orientation.w = math.cos(yaw / 2)
    s.tilt_deg = float(tilt)
    s.via_speed_mps = float(via_speed)
    s.dwell_s = float(dwell)
    s.tracked_frame = tracked
    return s


class Candidate:
    __slots__ = ("key", "cls", "x", "y", "top", "yaw", "tilt", "occluded", "vx", "tid", "off", "bp")

    def __init__(self, key, cls, x, y, top, yaw, tilt=0.0, occluded=False, vx=0.0, tid=None, off=(0.0, 0.0)):
        self.key, self.cls, self.x, self.y, self.top, self.yaw = key, cls, x, y, top, yaw
        self.tilt, self.occluded, self.vx, self.tid, self.off = tilt, occluded, vx, tid, off
        self.bp = 0.0  # cup heading minus product yaw at pick (a multiple of pi: products are symmetric)


class Tray:
    __slots__ = ("key", "x", "y", "z", "yaw", "occupied", "tilt", "vx", "tid", "stamp", "x_raw", "rx_age", "spec")

    def __init__(self, key, x, y, z, yaw, occupied, tilt=0.0):
        self.key, self.x, self.y, self.z, self.yaw, self.occupied, self.tilt = key, x, y, z, yaw, occupied, tilt
        self.spec = None  # TraySpec of this tray's model (set by the task from the message / the default)
        self.vx, self.tid = 0.0, None


class RunCycle(Node):
    def __init__(self):
        super().__init__("run_cycle")
        self.declare_parameter("perception", "vision")
        self.declare_parameter("tray_model", "tray_2x4")
        self.declare_parameter("cycles", 20)
        self.declare_parameter("pick_x_min", 0.10)
        self.declare_parameter("pick_x_max", 0.50)
        self.declare_parameter("hover", 0.03)
        self.declare_parameter("seal_timeout_s", 2.5)
        self.declare_parameter("track_lag_s", 0.04)  # s, cup behind a tracked pocket at belt speed (place x lead)
        self.declare_parameter("release_dwell_s", 0.25)  # s, keep tracking the pocket after the release command
        self.declare_parameter("outfeed_speed", 0.0)  # 0 = same as belt_speed
        self.declare_parameter("belt_speed", 0.10)
        # waiting pose behind the base: both cameras cover x in [-0.08, 0.78] for every |y| < 1.1, so anywhere else within
        # reach the arm hides products (bar recall 0.5-0.64 with the arm parked over the belt)
        self.declare_parameter("park", [-0.25, -0.25, 0.75])
        # continuous mode (M4): belts keep running; products/trays come from conveyor_tracker (/togsim/tracks/*) and
        # pick/place use TRACK_CART segments that follow the prod_<id> / tray_<id> TF frames
        self.declare_parameter("continuous", False)
        self.declare_parameter("pick_lead_s", 0.9)  # time to fly from the previous pose to the product
        self.declare_parameter("place_lead_s", 1.2)  # time from the pick to the pocket
        self.declare_parameter("track_dwell_s", 0.25)  # hold on the moving product while the cup seals
        self.declare_parameter(
            "contact_offset_m", -0.002
        )  # cup target relative to the estimated top (<0 = slight press)
        self.declare_parameter(
            "pick_direct", True
        )  # approach the moving product with TRACK segments only (no fly-through)
        self.mode = self.get_parameter("perception").value
        self.continuous = bool(self.get_parameter("continuous").value)
        cfg = yaml.safe_load(open(f"{get_package_share_directory('togsim_gazebo')}/config/trays.yaml"))
        self.tray = TraySpec.from_yaml(cfg, self.get_parameter("tray_model").value)
        self.tray_cfg = cfg
        self.specs = {self.tray.name: self.tray}  # per tray model (several models can share the outfeed)
        self.cb = ReentrantCallbackGroup()
        self.lock = threading.Lock()
        self.declare_parameter("eval", True)  # ground-truth metrics/diagnostics (benches); off for a plain demo
        self.gteval = GroundTruthEval(self, enabled=bool(self.get_parameter("eval").value) or self.mode == "gt")
        # (ground truth stores live in self.gteval)
        self.vis_cands = None
        self.vis_trays = {}  # id -> (TrayState, t)
        self.belt_state = {"infeed": 1.0, "outfeed": 1.0}
        self.latched = {}  # (tray_key, pocket) -> until
        # operator status for the HMI: one JSON message per event (cycle done, failure, state change)
        self.status_pub = self.create_publisher(String, "/togsim/hmi/status", 10)
        self.status = {
            "state": "init",
            "cycles": 0,
            "attempts": 0,
            "cpm": 0.0,
            "motion_s": 0.0,
            "failures": {},
            "last": "",
        }
        self.timelines = []  # per-cycle phase durations (wall seconds)
        self.t_cycle_end = None
        if self.continuous:  # tracks: stable ids + poses predicted to now, for both perception sources
            self.create_subscription(
                PickCandidateArray, "/togsim/tracks/products", self.on_cands, 5, callback_group=self.cb
            )
            self.create_subscription(TrayState, "/togsim/tracks/trays", self.on_tray, 10, callback_group=self.cb)
            # ground truth is still read for the placement-accuracy metric (never used for control in vision mode)
        elif self.mode == "gt":
            pass  # ground-truth perception: candidates/trays come from the GroundTruthEval store
        else:
            self.create_subscription(
                PickCandidateArray, "/togsim/pick_candidates", self.on_cands, 5, callback_group=self.cb
            )
            self.create_subscription(TrayState, "/togsim/tray_state", self.on_tray, 10, callback_group=self.cb)
        for b in ("infeed", "outfeed"):
            self.create_subscription(
                Float64, f"/togsim/conveyor/{b}/state", lambda m, b=b: self.belt_state.__setitem__(b, m.data), 10
            )
        self.motion = ActionClient(self, ExecuteMotion, "/togsim/execute_motion", callback_group=self.cb)
        self.vac_cmd = self.create_publisher(String, "/togsim/vacuum/cmd", 10)
        self.create_subscription(
            VacuumState, "/togsim/vacuum/state_msg", self.on_vacuum_state, 10, callback_group=self.cb
        )
        self.vac_sealed, self.vac_attached, self.vac_t = False, "", 0.0
        self.joints = {}
        self.cur_goal = ""
        self.rejected_log = {}
        self.in_pocket = False
        self.cfg = None  # CycleConfig of the running continuous cycle
        self.blacklist = {}  # product key -> monotonic time until which it is not picked again
        self.psi_seal = None  # cup yaw at the last seal (diagnostic)
        self.last_on_tray = time.monotonic()
        self.approach_est = 1.4  # s, pick start -> contact, refined online
        self.rtf = 1.0  # simulation seconds per wall second, measured (see rtf_now)
        self.rtf_hist = deque()
        self.idle_why = dict.fromkeys(
            ("seen", "occluded", "window", "reach", "blacklist", "no tray for class", "other", "no_tray", "polls"), 0
        )
        self.create_subscription(JointState, "/joint_states", self.on_joint_state, 10)
        self.vac = self.create_client(SetVacuum, "/togsim/vacuum", callback_group=self.cb)
        self.infeed = self.create_publisher(Float64, "/togsim/conveyor/infeed/cmd_vel", 10)
        self.outfeed = self.create_publisher(Float64, "/togsim/conveyor/outfeed/cmd_vel", 10)

    # ---------------- perception inputs ----------------

    def on_cands(self, msg):
        with self.lock:
            self.vis_cands = (msg, time.monotonic())

    def on_tray(self, msg):
        now = time.monotonic()
        gap = now - self.last_on_tray
        self.last_on_tray = now
        if gap > 0.3 and self.vis_trays:  # diagnostic: subscription callbacks stalled (executor starved?)
            self.get_logger().warn(f"tray callback gap {gap:.2f} s during '{self.cur_goal}'")
        with self.lock:
            self.vis_trays[msg.tray_id] = (msg, now)

    def candidates(self, fits):
        out = []
        with self.lock:
            if self.mode == "gt" and not self.continuous:
                for n, (p, yaw, tilt, _) in self.gt.items():
                    if not n.startswith("product_"):
                        continue
                    cls = "product_" + n.split("_")[1]
                    if cls in fits and p[2] < 0.6:
                        out.append(Candidate(n, cls, p[0], p[1], p[2] + PRODUCT_HEIGHT[cls], yaw, tilt))
            elif self.vis_cands and time.monotonic() - self.vis_cands[1] < 1.0:
                st = self.vis_cands[0].header.stamp
                dt_c = min(1.0, max(0.0, self.sim_now() - (st.sec + st.nanosec * 1e-9)))
                for c in self.vis_cands[0].candidates:
                    if c.class_name in fits:
                        p = c.grasp_pose.pose.position
                        out.append(
                            Candidate(
                                f"v{c.id}",
                                c.class_name,
                                p.x + c.belt_velocity.x * dt_c,
                                p.y,
                                p.z,
                                math.radians(c.yaw_deg),
                                math.radians(c.tilt_deg),
                                c.occluded,
                                c.belt_velocity.x,
                                int(c.id),
                                (c.centre_offset.x, c.centre_offset.y),
                            )
                        )
        return out

    def trays(self):
        out = []
        with self.lock:
            if self.mode == "gt" and not self.continuous:
                for n, (p, yaw, tilt, _) in self.gt.items():
                    if not n.startswith("tray_"):
                        continue
                    occ = [False] * self.tray.n_pockets
                    for m, (pp, _, _, _) in self.gt.items():
                        if m.startswith("product_") and abs(pp[2] - p[2]) < 0.06:
                            idx = self.tray.pocket_of_point(p, yaw, pp[0], pp[1])
                            if idx is not None:
                                occ[idx] = True
                    tr = Tray(n, p[0], p[1], p[2], yaw, occ, tilt)
                    tr.spec = self.tray
                    out.append(tr)
            else:
                now = time.monotonic()
                t_sim = self.sim_now()
                for tid, (m, t) in list(self.vis_trays.items()):
                    if now - t > 1.0:
                        self.vis_trays.pop(tid, None)
                        continue
                    p = m.pose.pose.position
                    # predict from the message stamp: callbacks lag by up to a second while the main thread is busy
                    # (a stale pose made the second place decision per tray 85 mm behind the tray)
                    dt = min(1.0, max(0.0, t_sim - (m.header.stamp.sec + m.header.stamp.nanosec * 1e-9)))
                    tr = Tray(
                        f"t{tid}", p.x + m.velocity.x * dt, p.y, p.z, yaw_of(m.pose.pose.orientation), list(m.occupied)
                    )
                    tr.stamp, tr.x_raw = m.header.stamp.sec + m.header.stamp.nanosec * 1e-9, p.x
                    tr.spec = self.spec_for(getattr(m, "model", ""))
                    tr.rx_age = now - t  # monotonic age of the stored message (diagnostic)
                    tr.vx, tr.tid = m.velocity.x, int(tid)
                    out.append(tr)
        return out

    # ---------------- actuation helpers ----------------
    def belts(self, speed):
        out = float(self.get_parameter("outfeed_speed").value)
        out = out if out > 0.0 else float(speed)  # a slower outfeed widens each tray's placeable window
        for _ in range(2):
            self.infeed.publish(Float64(data=float(speed)))
            self.outfeed.publish(Float64(data=out))
            time.sleep(0.05)

    def wait_belts_stopped(self, timeout=2.0):
        t0 = time.monotonic()
        while time.monotonic() - t0 < timeout:
            if max(abs(v) for v in self.belt_state.values()) < 0.003:
                return True
            time.sleep(0.02)
        return False

    def run_motion(self, segments, label, on_feedback=None):
        goal = ExecuteMotion.Goal()
        goal.segments = segments
        fut = self.motion.send_goal_async(goal, feedback_callback=on_feedback)
        t0 = time.monotonic()
        while not fut.done():
            time.sleep(0.002)
            if time.monotonic() - t0 > 5.0:
                self.get_logger().error(f"{label}: goal not accepted")
                return False
        gh = fut.result()
        if not gh.accepted:
            return False
        rf = gh.get_result_async()
        t0 = time.monotonic()
        while not rf.done():
            time.sleep(0.002)
            if time.monotonic() - t0 > 30.0:
                gh.cancel_goal_async()
                return False
        res = rf.result().result
        self.get_logger().info(f"motion {label}: {res.duration_s:.2f} s")
        if not res.success:
            self.get_logger().warn(f"{label}: {res.message} (code {res.error_code})")
        return res.success

    def vacuum(self, on, timeout=0.5):
        req = SetVacuum.Request()
        req.on, req.target_model, req.timeout_s = on, "auto", float(timeout)
        fut = self.vac.call_async(req)
        while not fut.done():
            time.sleep(0.002)
        return fut.result()

    def spec_for(self, model):
        """TraySpec for a tray model name (the default spec when the model is unknown or empty)."""
        if not model or model == self.tray.name:
            return self.tray
        if model not in self.specs:
            try:
                self.specs[model] = TraySpec.from_yaml(self.tray_cfg, model)
            except KeyError:
                self.specs[model] = self.tray
        return self.specs[model]

    def free_pocket(self, tray):
        now = time.monotonic()
        spec = tray.spec or self.tray
        for i in range(spec.n_pockets):
            if tray.occupied[i] or self.latched.get((tray.key, i), 0) > now:
                continue
            px, py, _ = spec.pocket_world((tray.x, tray.y, tray.z), tray.yaw, i)
            if reachable(px, py):
                return i
        return None

    # ---------------- continuous (M4), event driven ----------------
    def send_goal(self, segments, label, on_feedback=None):
        """Asynchronous goal: returns the goal handle (None if rejected). A goal sent while another runs preempts it
        seamlessly in motion_server, so chaining goals early is how the arm never comes to a full stop."""
        self.cur_goal = label
        goal = ExecuteMotion.Goal()
        goal.segments = segments
        fut = self.motion.send_goal_async(goal, feedback_callback=on_feedback)
        t0 = time.monotonic()
        while not fut.done():
            time.sleep(0.002)
            if time.monotonic() - t0 > 5.0:
                self.get_logger().error(f"{label}: goal not accepted")
                return None
        gh = fut.result()
        return gh if gh.accepted else None

    def wait_result(self, gh, label, timeout=30.0):
        rf = gh.get_result_async()
        t0 = time.monotonic()
        while not rf.done():
            time.sleep(0.002)
            if time.monotonic() - t0 > timeout:
                gh.cancel_goal_async()
                return False, "timeout"
        res = rf.result().result
        if not res.success and res.error_code != ExecuteMotion.Result.PREEMPTED:
            self.get_logger().warn(f"{label}: {res.message} (code {res.error_code})")
        return res.success or res.error_code == ExecuteMotion.Result.PREEMPTED, res.message

    def sim_now(self):
        return self.get_clock().now().nanoseconds * 1e-9

    def rtf_now(self):
        """Simulation seconds per wall second over the last ~3 s. The leads are wall-clock motion durations while the
        belts move in simulation time: during a motion of `lead` seconds a product travels vx * lead * rtf, so every
        look-ahead is scaled by this, and every wait that is belt time (seal deadline, pocket hold, blacklist, pocket
        latch) by its inverse. At real time it is 1; below it (a loaded simulator) the unscaled leads aimed ~100 mm
        ahead of the product and the seal deadline expired during the approach."""
        w, sim = time.monotonic(), self.sim_now()
        self.rtf_hist.append((w, sim))
        while len(self.rtf_hist) > 2 and w - self.rtf_hist[0][0] > 3.0:
            self.rtf_hist.popleft()
        w0, s0 = self.rtf_hist[0]
        if w - w0 >= 1.0:
            self.rtf = min(1.2, max(0.2, (sim - s0) / (w - w0)))
        return self.rtf

    def on_joint_state(self, msg):
        with self.lock:
            self.joints = dict(zip(msg.name, msg.position))

    def cup_yaw(self):
        """TCP heading from the measured joints (J1 + J2 + J4); None until joint states arrive."""
        with self.lock:
            js = self.joints
        vals = [js[n] for n in js if n.endswith(("j1_joint", "j2_joint", "j4_joint"))]
        return sum(vals) if len(vals) == 3 else None

    def on_vacuum_state(self, msg):
        with self.lock:
            changed = bool(msg.sealed) != self.vac_sealed
            self.vac_sealed, self.vac_attached, self.vac_t = bool(msg.sealed), msg.attached_model, time.monotonic()
        if changed:
            self.get_logger().info(f"vacuum state sealed={msg.sealed} model={msg.attached_model}")

    def vacuum_cmd(self, on):
        self.vac_cmd.publish(String(data="on" if on else "off"))
        self.get_logger().info(f"vacuum cmd {'on' if on else 'off'}")

    # ---------------- continuous cycle: schedule -> pick -> choose pocket -> place ----------------
    def run_continuous(self):
        """Belts never stop. Pick: TRACK hover -> TRACK contact (dwell = seal budget); the vacuum is switched on when the
        hover is reached and the place goal is sent the instant the gripper reports a seal (it preempts the dwell).
        Place: lift -> TRACK pocket hover -> TRACK pocket contact; the release is commanded when the contact is reached
        and the next pick goal follows right after the short settle dwell. No service round-trips in the cycle.

        A cycle is four phases, one method each: `schedule` (what is pickable now and where it can go), `pick` (fly,
        track, seal; measures the grasp offset), `choose_pocket` (chosen after the pick: the tray picked before has
        moved on) and `place` (track the pocket, release, unseal). Ground-truth diagnostics live in `self.gteval`
        and are inert without `eval`."""
        p = self.get_parameter
        self.cfg = CycleConfig(
            belt_speed=float(p("belt_speed").value),
            hover=float(p("hover").value),
            x_window=(p("pick_x_min").value, p("pick_x_max").value),
            lead=float(p("pick_lead_s").value),
            place_lead=float(p("place_lead_s").value),
            seal_budget=max(0.8, float(p("track_dwell_s").value) * 3.0),  # the place goal preempts on seal
            contact=float(p("contact_offset_m").value),
            seal_timeout=float(p("seal_timeout_s").value),
            track_lag=float(p("track_lag_s").value),
            release_dwell=float(p("release_dwell_s").value),
            fits=sorted({cls for name in PRODUCT_FITS for cls in PRODUCT_FITS[name]}),  # any class a known tray takes
            park=[float(v) for v in p("park").value],
        )
        cfg = self.cfg
        done, attempts = 0, 0
        cycle_times, t_start = [], None
        self.blacklist = {}
        self.go_park()
        parked = True
        self.belts(cfg.belt_speed)
        self.publish_status("running", last="started")
        last_report = 0.0
        while rclpy.ok() and done < int(p("cycles").value):
            now = time.monotonic()
            trays, cands = self.schedule(now)
            if not trays or not cands:
                if now - last_report > 5.0:
                    last_report = now
                    self.get_logger().info(f"waiting: {len(cands)} pickable, {len(trays)} trays ready")
                if not parked and not self.product_due(cfg.fits, 3.0):
                    parked = self.go_park()
                time.sleep(0.03)
                continue
            c, x_arrive = max(cands, key=lambda ca: ca[1])
            if t_start is None:
                t_start = time.monotonic()
            tc = time.monotonic()
            tl = {"idle": tc - self.t_cycle_end if self.t_cycle_end else 0.0}
            self.log_idle(tl["idle"])
            attempts += 1
            parked = False
            sealed, held = self.pick(c, x_arrive, tc, tl, attempts)
            if not sealed:
                continue
            tray, pocket = self.choose_pocket(c, trays)
            ok = self.place(c, held, tray, pocket, tl)
            self.t_cycle_end = time.monotonic()
            self.timelines.append(tl)
            self.get_logger().info("timeline " + " ".join(f"{k} {v:.2f}" for k, v in tl.items()))
            if ok:
                done += 1
                cycle_times.append(time.monotonic() - tc)
                el = time.monotonic() - t_start
                self.publish_status(
                    "running",
                    cycles=done,
                    attempts=attempts,
                    cpm=round(60.0 * done / el, 1),
                    motion_s=round(sum(cycle_times) / len(cycle_times), 2),
                    last=f"cycle {done} placed {c.key} -> {tray.key}[{pocket}]",
                )
                self.get_logger().info(
                    f"cycle {done}: {cycle_times[-1]:.2f} s | {60.0 * done / el:.1f} cpm | mean motion "
                    f"{sum(cycle_times) / len(cycle_times):.2f} s | success {done}/{attempts} | rtf {self.rtf:.2f}"
                )
        self.get_logger().info(f"finished: {done} cycles, {attempts} attempts, mode={self.mode} continuous")
        self.publish_status("finished", cycles=done, attempts=attempts)
        time.sleep(0.6)  # let the last placement measurement finish
        self.report_placement()
        if self.timelines:
            keys = ["idle", "approach", "seal_wait", "transfer", "release"]
            means = {k: sum(t.get(k, 0.0) for t in self.timelines) / len(self.timelines) for k in keys}
            self.get_logger().info("timeline means " + " ".join(f"{k} {v:.2f}" for k, v in means.items()))

    def go_park(self):
        park = self.cfg.park
        return self.run_motion([seg(MotionSegment.PTP_CART, *park, math.atan2(park[1], park[0]))], "park")

    def schedule(self, now):
        """Phase 1, what can be done right now: the trays with a free pocket that will still be reachable once the
        product is in hand, as (tray, pocket), and the products a tray in the window takes, as (candidate, x at the
        pick lead). Keeps the idle accounting (`idle_why`) and logs the trays rejected for occupancy (vs GT)."""
        cfg = self.cfg
        rtf = self.rtf_now()
        lead, place_lead = cfg.lead * rtf, cfg.place_lead * rtf  # wall-clock motion durations in belt (sim) seconds
        trays = []
        for t in self.trays():
            if t.tid is None or t.tilt > math.radians(3) or abs(t.z - BELT_Z) > 0.012:
                continue
            # the place starts only after the pick: the pocket must still be reachable then (approach_est = the
            # running mean of the pick approach time; a check at the current lead chose pockets that had left
            # the reach by the time the product was in hand)
            pocket = self.free_pocket_moving(t, place_lead + self.approach_est, margin=0.0)
            if pocket is not None:
                trays.append((t, pocket))
            elif -0.35 < t.x < 0.70 and self.rejected_log.get(t.key, 0) < now:
                # diagnostic: a tray in the window with no usable pocket - vision occupancy vs GT occupancy
                self.rejected_log[t.key] = now + 2.0
                self.get_logger().info(
                    f"rejected tray {t.key} at x {t.x:.2f}: vision occupied"
                    f" {''.join('x' if v else '.' for v in t.occupied)} vs GT {self.gteval.occupancy_gt(t)}"
                )
        # only products that a tray in the window can take (several tray models may share the outfeed)
        fits_now = {cls for t, _ in trays for cls in PRODUCT_FITS.get((t.spec or self.tray).name, [])}
        cands = []
        why = self.idle_why  # why candidates are not pickable right now (diagnostic for the idle time)
        for c in self.candidates(cfg.fits):
            why["seen"] += 1
            reason = candidate_reason(c, lead, cfg.x_window, fits_now, BELT_Z, self.blacklist, now)
            if reason is None and c.tid is not None:
                cands.append((c, c.x + c.vx * lead))
            elif reason is not None:
                why[reason if reason in why else "other"] += 1
        if not trays:
            why["no_tray"] += 1
        why["polls"] += 1
        return trays, cands

    def log_idle(self, idle):
        """Why the arm waited before this cycle, per scheduler poll (then reset the accounting)."""
        why = self.idle_why
        if idle > 0.5 and why["polls"]:
            n = why["polls"]
            self.get_logger().info(
                f"idle {idle:.1f} s: per poll {why['seen'] / n:.1f} tracked, {why['occluded'] / n:.1f} occluded,"
                f" {why['window'] / n:.1f} outside x-window, {why['reach'] / n:.1f} unreachable,"
                f" {why['blacklist'] / n:.1f} blacklisted, {why['no tray for class'] / n:.1f} no tray for class,"
                f" {why['other'] / n:.1f} other; no tray {100 * why['no_tray'] / n:.0f} % of polls"
            )
        self.idle_why = dict.fromkeys(self.idle_why, 0)

    def pick(self, c, x_arrive, tc, tl, attempts):
        """Phase 2: fly through the predicted hover point, track the product down to contact and wait for the seal.
        Returns (sealed, held product name as the gripper reports it). A failed pick is blacklisted, retreated from
        and counted. On success tl['approach'] / tl['seal_wait'] are set, `approach_est` is refined (simulation
        seconds) and the vision grasp offset `c.off` is replaced by the one measured at the seal."""
        cfg = self.cfg
        tc_sim = self.sim_now()  # kinematic leads are simulation time (RTF-invariant)
        frame = f"prod_{c.tid}"
        lift = self.joint_lift(0.04) if self.in_pocket else []
        n_pick = 3 + len(lift)
        ev = {"contact": None, "vac_on": None, "contact_gt": None, "contact_sim": None}

        def on_fb_pick(fb, n=n_pick):
            p = fb.feedback.progress
            self.get_logger().debug(
                f"fb pick seg {fb.feedback.segment_index} progress {p:.3f} t+{time.monotonic() - tc:.2f}"
            )
            # progress is (idx + 1) / n when a segment completes and (idx + 0.5) / n when the last one is reached
            if abs(p - (n - 1.0) / n) < 1e-3 and ev["vac_on"] is None:  # hover reached: descending onto the product
                self.vacuum_cmd(True)
                ev["vac_on"] = time.monotonic()
            if abs(p - (n - 0.5) / n) < 1e-3 and ev["contact"] is None:  # contact reached, dwelling
                ev["contact"] = time.monotonic()
                ev["contact_sim"] = self.sim_now()
                # diagnostic (GT): where is the product relative to the estimate the cup just landed on?
                ev["contact_gt"] = self.gteval.nearest_product(c.x + c.vx * (ev["contact"] - tc) * self.rtf, c.y)

        # fly through the predicted hover point at speed (a plain PTP/VIA is faster than converging a tracked target
        # from far away), then track: hover -> contact
        cur = self.cup_yaw()
        yaw_pick = c.yaw if cur is None else nearest_branch(c.yaw, cur)
        c.bp = yaw_pick - c.yaw
        # straight up first when the cup is still in the pocket it just filled (at wall-top height): a diagonal
        # departure clips the rim and drags the tray. A PTP: a via point at the current pose never completes.
        pick = lift + [
            seg(MotionSegment.VIA_CART, x_arrive, c.y, c.top + cfg.hover, yaw_pick, via_speed=0.5),
            seg(MotionSegment.TRACK_CART, 0.0, 0.0, cfg.hover, c.bp, tracked=frame),
            # the pick contact may settle loosely: the grasp offset is measured at the seal and compensated at the
            # place, where the tight tolerance matters
            seg(
                MotionSegment.TRACK_CART, 0.0, 0.0, cfg.contact, c.bp, dwell=cfg.seal_budget, tracked=frame, settle=0.005
            ),
        ]
        self.in_pocket = False
        gh = self.send_goal(pick, f"pick {c.key}", on_feedback=on_fb_pick)
        if gh is None:
            self.blacklist[c.key] = time.monotonic() + 15.0 / self.rtf
            return False, None
        rf = gh.get_result_async()
        sealed = False
        # a contact that does not seal within a couple of seconds never will (cup on a seam, pushed product):
        # give the product up instead of riding it down the belt
        t_deadline = time.monotonic() + cfg.seal_timeout / self.rtf  # belt seconds: the approach is physics too
        while time.monotonic() < t_deadline:
            with self.lock:
                if ev["vac_on"] and self.vac_sealed and self.vac_t > ev["vac_on"]:
                    sealed = True
            if sealed or rf.done():
                break
            time.sleep(0.002)
        t_sealed = time.monotonic()
        if not sealed:
            _ok, msg = (rf.result().result.success, rf.result().result.message) if rf.done() else (False, "no seal")
            detail = self.gteval.no_seal_detail(c, ev["contact_gt"], c.x + c.vx * (t_sealed - tc) * self.rtf)
            self.get_logger().warn(
                f"pick {c.key} failed: {msg} ({t_sealed - tc:.2f} s after start, x_arrive {x_arrive:.3f}, y {c.y:.3f})"
                f"{detail}"
            )
            fl = dict(self.status.get("failures", {}))
            fl["pick"] = fl.get("pick", 0) + 1
            self.publish_status("running", attempts=attempts, failures=fl, last=f"pick {c.key} failed: {msg}")
            self.blacklist[c.key] = time.monotonic() + 15.0 / self.rtf
            self.vacuum_cmd(False)
            if not rf.done():
                gh.cancel_goal_async()
            time.sleep(0.05)
            self.run_motion([seg(MotionSegment.PTP_CART, 0.0, 0.0, cfg.hover, 0.0, frame="tcp")], "retreat")
            return False, None
        tl["approach"] = (ev["contact"] or t_sealed) - tc
        # the look-ahead must be in simulation seconds: below real time a wall-clock estimate is too long
        self.approach_est = 0.8 * self.approach_est + 0.2 * ((ev["contact_sim"] or self.sim_now()) - tc_sim)
        tl["seal_wait"] = t_sealed - (ev["contact"] or t_sealed)
        with self.lock:
            held = self.vac_attached
        self.blacklist[c.key] = time.monotonic() + 15.0 / self.rtf  # its track lives on by prediction: never pick the ghost
        tp = self.track_pose(c.tid)
        fk = self.fk_xy()
        if tp is not None and fk is not None:
            # the track is the grasp point (suction point), `c.off` the product centre relative to it (vision); the
            # cup seals a few mm off the grasp point too (settle tolerance, tracker error, prediction during the
            # occluded descent), measured here from the track and the cup (FK). The place compensates the sum:
            # centre - cup = (centre - grasp point) + (grasp point - cup). Replacing the first by the second was
            # invisible on cartons (suction point ~ centre) and put bars 30-50 mm off along their length.
            off_meas = (tp.x - fk[0], tp.y - fk[1])
            if math.hypot(*off_meas) < 0.03:
                total = (c.off[0] + off_meas[0], c.off[1] + off_meas[1])
                self.get_logger().info(
                    f"grasp offset: centre-grasp (vision) ({1e3 * c.off[0]:+.0f},{1e3 * c.off[1]:+.0f}) + grasp-cup"
                    f" (measured) ({1e3 * off_meas[0]:+.0f},{1e3 * off_meas[1]:+.0f}) = ({1e3 * total[0]:+.0f},"
                    f"{1e3 * total[1]:+.0f}) mm"
                )
                c.off = total
        self.psi_seal = self.cup_yaw()
        self.gteval.log_grasp_offset(c, held, tp, self.psi_seal)  # diagnostic (GT): where the cup really sealed
        return True, held

    def choose_pocket(self, c, trays):
        """Phase 3: the tray is chosen now (the one selected before the pick has moved on). The nearest free pocket
        that will still be reachable with margin; else one reachable right now; else hold the product up to 6 s for
        a pocket to come in reach; as a last resort the pre-pick choice `trays[0]`."""
        place_lead = self.cfg.place_lead * self.rtf  # belt seconds during the wall-clock transfer

        def reachable_pockets(margin):
            fresh = []
            for t in self.trays():
                if t.tid is None or t.tilt > math.radians(3) or abs(t.z - BELT_Z) > 0.012:
                    continue
                if c.cls not in PRODUCT_FITS.get((t.spec or self.tray).name, []):
                    continue
                pk = self.free_pocket_moving(t, place_lead, margin=margin)
                if pk is not None:
                    px, py, _ = (t.spec or self.tray).pocket_world((t.x + t.vx * place_lead, t.y, t.z), t.yaw, pk)
                    fresh.append((math.hypot(px - c.x, py - c.y), t, pk))
            return fresh

        fresh = reachable_pockets(0.5)
        if not fresh:  # nothing with margin: the pockets that are still reachable right now, no margin
            fresh = reachable_pockets(0.0)
            if fresh:
                self.get_logger().info("place: no pocket with reach margin, taking one reachable now")
        t_wait0 = time.monotonic()
        hold = 6.0 / self.rtf  # belt seconds
        while not fresh and time.monotonic() - t_wait0 < hold:  # hold the product until a pocket comes in reach
            if time.monotonic() - t_wait0 < 0.05:
                self.get_logger().info("place: waiting for a reachable pocket (holding the product)")
            time.sleep(0.05)
            fresh = reachable_pockets(0.3)  # a pocket at the edge ends the place where the lift cannot be solved
        if fresh:
            _, tray, pocket = min(fresh, key=lambda f: f[0])  # shortest transfer
            return tray, pocket
        tray, pocket = trays[0]
        self.get_logger().warn(
            f"place: no reachable pocket in {hold:.0f} s, falling back to {tray.key}[{pocket}] seen before the pick"
        )
        return tray, pocket

    def place(self, c, held, tray, pocket, tl):
        """Phase 4: transfer above the pocket walls, track the pocket down, release on contact, wait for the unseal.
        The cup holds the product off-centre by the measured grasp offset: expressed in the product frame that
        offset is constant through the J4 turn, so the cup aims at pocket - offset. Returns the motion result; sets
        tl['transfer'] / tl['release'], latches the pocket and starts the (GT) placement measurement."""
        place_lead = self.cfg.place_lead * self.rtf
        h = PRODUCT_HEIGHT[c.cls]
        tframe = f"tray_{tray.tid}"
        spec = tray.spec or self.tray
        ox, oy = spec.pocket_offset(pocket)
        self.get_logger().info(
            f"place decision {c.key} -> {tray.key}[{pocket}]: tray x {tray.x:.2f} z {tray.z:.3f} yaw {math.degrees(tray.yaw):+.0f}, occupied"
            f" {''.join('x' if v else '.' for v in tray.occupied)}{self.gteval.tray_frame_detail(tray)}"
        )
        cur = self.cup_yaw()
        yaw_place = tray.yaw if cur is None else nearest_branch(tray.yaw, cur)
        bq = yaw_place - tray.yaw
        sgn = round(math.cos(bq - c.bp))  # +-1: the product frame relative to the tray frame once placed
        cp, sp = math.cos(-c.yaw), math.sin(-c.yaw)
        offx, offy = cp * c.off[0] - sp * c.off[1], sp * c.off[0] + cp * c.off[1]
        # sanity: the centre can be at most half the product length from the suction point; beyond that the offset
        # comes from a bad mask, not from the grasp
        if math.hypot(offx, offy) < 0.5 * PRODUCT_LENGTH.get(c.cls, 0.07) + 0.01:
            ox, oy = ox - sgn * offx, oy - sgn * offy
        if self.cfg.track_lag > 0.0:
            # the measured arm trails the tracked pocket by belt speed x servo lag (~2 mm at 0.05 m/s in every carton
            # bench): aim that much ahead along the belt, expressed in the tray frame
            lead_m = tray.vx * self.cfg.track_lag
            ox, oy = ox + math.cos(tray.yaw) * lead_m, oy - math.sin(tray.yaw) * lead_m
        # release 10 mm above the pocket floor: the pocket walls (25 mm) still guide the product, and with 5 mm of
        # clearance per side a cup that is a few mm off would otherwise press the product onto a wall and drag the
        # tray along the belt
        z_place = spec.base_thickness + h + 0.010
        # the product hangs below the cup: approach above the pocket walls (flying to a far pocket crosses the
        # others), then descend vertically in the tray frame. Clipping a wall at belt speed throws the tray.
        # 50 mm: the blended fly-through arrives ~20 mm short in z when a long product crosses the near wall (GT tool
        # pose at the shoves: bar bottom 3 mm below the wall top with the 20 mm figure), and a clipped wall drags the tray
        z_clear = spec.base_thickness + spec.pocket_depth + 0.05 + h
        rel = {"t": None}

        def on_fb_place(fb, n=3):
            if abs(fb.feedback.progress - 2.5 / n) < 1e-3 and rel["t"] is None:  # pocket contact reached: release
                self.vacuum_cmd(False)
                rel["t"] = time.monotonic()
                self.gteval.log_release_yaw(held, tray, pocket, (ox, oy), self.psi_seal)

        px_w, py_w, _zf = spec.pocket_world((tray.x + tray.vx * place_lead, tray.y, tray.z), tray.yaw, pocket)
        place = [
            seg(MotionSegment.VIA_CART, px_w, py_w, tray.z + z_clear, yaw_place, via_speed=0.35),
            seg(MotionSegment.TRACK_CART, ox, oy, z_clear, bq, tracked=tframe),
            # 3.5 mm on the measured arm: the steady command-measured lag while tracking is ~2 mm, a 2.5 mm
            # tolerance hovered at the threshold for a second
            # the dwell keeps the cup tracking the pocket while the vacuum lets go (0.1-0.16 s after the command): a
            # cup that stops tracking before the unseal leaves the product 5-10 mm behind the pocket along the belt
            seg(
                MotionSegment.TRACK_CART, ox, oy, z_place, bq, dwell=self.cfg.release_dwell, tracked=tframe, settle=0.0035
            ),
        ]
        t_place0 = time.monotonic()
        ghp = self.send_goal(place, f"place {c.key} -> {tray.key}[{pocket}]", on_feedback=on_fb_place)
        ok = False
        if ghp is not None:
            ok, _ = self.wait_result(ghp, f"place {c.key} -> {tray.key}[{pocket}]")
        if rel["t"] is None:  # the contact feedback never came (failed place): make sure the cup lets go
            self.vacuum_cmd(False)
        tl["transfer"] = (rel["t"] or time.monotonic()) - t_place0
        tl["release"] = time.monotonic() - (rel["t"] or time.monotonic())
        if rel["t"] is not None:
            # the vacuum lets go with a delay: leaving before it does drags the product along the departure
            t_u0 = time.monotonic()
            while time.monotonic() - t_u0 < 0.5:
                with self.lock:
                    if not self.vac_sealed:
                        break
                time.sleep(0.005)
            self.get_logger().info(f"unsealed after {time.monotonic() - rel['t']:.3f} s (release command to unsealed)")
        self.latched[(tray.key, pocket)] = time.monotonic() + 2.0 / self.rtf  # until the vacancy view catches up
        self.in_pocket = rel["t"] is not None  # the cup is down in the pocket: the next goal must lift first
        threading.Thread(target=self.measure_placement, args=(c.key, tray, pocket, held), daemon=True).start()
        return ok

    # ---------------- placement accuracy (ground truth, metric only) ----------------
    def joint_lift(self, dz):
        """A straight lift as a joint-space PTP (J3 + dz): always solvable, even when the place tracked a pocket to the
        edge of the workspace where a Cartesian lift at the current xy has no IK solution."""
        with self.lock:
            js = dict(self.joints)
        names = ("j1_joint", "j2_joint", "j3_joint", "j4_joint", "tilt_joint")
        q = [next((v for n, v in js.items() if n.endswith(nm)), None) for nm in names]
        if any(v is None for v in q):
            return [seg(MotionSegment.PTP_CART, 0.0, 0.0, dz, 0.0, frame="tcp")]
        s = MotionSegment()
        s.type = MotionSegment.PTP_JOINT
        q[2] = min(0.0, q[2] + dz)
        s.joint_target = [float(v) for v in q]
        return [s]

    # ---- ground-truth evaluation (togsim_task.diagnostics): metrics and diagnostics only, never control ----
    @property
    def gt(self):
        return self.gteval.gt

    @property
    def gt_hist(self):
        return self.gteval.gt_hist

    @property
    def gt_tool(self):
        return self.gteval.gt_tool

    @property
    def placements(self):
        return self.gteval.placements

    def in_tray_frame(self, pp, gt=None):
        return self.gteval.in_tray_frame(pp, gt)

    def frame_err_now(self, tid):
        return self.gteval.frame_err_now(tid)

    def fk_vs_gt(self, gt_xy):
        return self.gteval.fk_vs_gt(gt_xy)

    def measure_placement(self, key, tray, pocket, held=""):
        return self.gteval.measure_placement(key, tray, pocket, held)

    def report_placement(self):
        return self.gteval.report_placement()

    def fk_xy(self):
        """Planar FK of the measured joints (l1 0.40, l2 0.25; base at the world origin; matches the GT cup to 1 mm)."""
        with self.lock:
            js = dict(self.joints)
        j1 = next((v for n, v in js.items() if n.endswith("j1_joint")), None)
        j2 = next((v for n, v in js.items() if n.endswith("j2_joint")), None)
        if j1 is None or j2 is None:
            return None
        return 0.40 * math.cos(j1) + 0.25 * math.cos(j1 + j2), 0.40 * math.sin(j1) + 0.25 * math.sin(j1 + j2)

    def publish_status(self, state=None, **kw):
        if state is not None:
            self.status["state"] = state
        self.status.update(kw)
        offs = [1e3 * o for o, _ in self.placements]
        if offs:
            srt = sorted(offs)
            self.status["placement_mean_mm"] = round(sum(offs) / len(offs), 1)
            self.status["placement_p95_mm"] = round(srt[int(0.95 * (len(srt) - 1))], 1)
        self.status["t"] = round(time.time(), 2)
        try:
            self.status_pub.publish(String(data=json.dumps(self.status)))
        except Exception as e:  # noqa: BLE001 - best effort: the run must not fail because the HMI feed did
            self.get_logger().warn(f"status publish failed: {e}")

    def track_pose(self, tid):
        """Current (predicted-to-now) pose of a product track, or None if it is gone."""
        with self.lock:
            if self.vis_cands is None:
                return None
            for c in self.vis_cands[0].candidates:
                if int(c.id) == tid:
                    p = c.grasp_pose.pose.position
                    return Candidate(
                        f"v{c.id}", c.class_name, p.x, p.y, p.z, math.radians(c.yaw_deg), vx=c.belt_velocity.x, tid=tid
                    )
        return None

    def product_due(self, fits, horizon_s):
        """True if a fitting product track will enter the pick window within `horizon_s` (no point parking then)."""
        xmin = float(self.get_parameter("pick_x_min").value)
        for c in self.candidates(fits):
            if c.tid is None or c.vx <= 0.01:
                continue
            eta = (xmin - c.x) / c.vx
            if -1.0 < eta < horizon_s and -0.6 < c.y < -0.1:
                return True
        return False

    def free_pocket_moving(self, tray, lead, margin=0.5):
        """First free, unlatched pocket that will still be reachable `lead` (+ `margin`) seconds from now."""
        return free_pocket(tray.spec or self.tray, tray, lead, margin, self.latched, time.monotonic())

    # ---------------- main loop ----------------
    def run(self):
        self.get_logger().info(f"perception={self.mode}; waiting for motion server / vacuum ...")
        self.motion.wait_for_server()
        self.vac.wait_for_service()
        if self.continuous:
            return self.run_continuous()
        belt_speed = float(self.get_parameter("belt_speed").value)
        hover = float(self.get_parameter("hover").value)
        xmin, xmax = self.get_parameter("pick_x_min").value, self.get_parameter("pick_x_max").value
        fits = PRODUCT_FITS[self.tray.name]
        done, attempts = 0, 0
        cycle_times, t_start = [], None
        blacklist = {}
        park = [float(v) for v in self.get_parameter("park").value]
        self.run_motion([seg(MotionSegment.PTP_CART, *park, math.atan2(park[1], park[0]))], "park")
        parked = True
        self.belts(belt_speed)
        last_report = 0.0
        while rclpy.ok() and done < int(self.get_parameter("cycles").value):
            now = time.monotonic()
            trays = [
                t
                for t in self.trays()
                if 0.05 < t.x < 0.40
                and t.tilt < math.radians(3)
                and abs(t.z - BELT_Z) < 0.012
                and self.free_pocket(t) is not None
            ]
            cands = [
                c
                for c in self.candidates(fits)
                if xmin < c.x < xmax
                and -0.6 < c.y < -0.1
                and reachable(c.x, c.y)
                and not c.occluded
                and c.tilt < math.radians(4)
                and blacklist.get(c.key, 0) < now
            ]
            if not trays or not cands:
                if now - last_report > 5.0:
                    last_report = now
                    self.get_logger().info(f"waiting: {len(cands)} pickable, {len(trays)} trays ready")
                self.belts(belt_speed)
                if not parked:  # get out of the cameras' view while nothing is pickable
                    parked = self.run_motion([seg(MotionSegment.PTP_CART, *park, math.atan2(park[1], park[0]))], "park")
                time.sleep(0.1)
                continue
            self.belts(0.0)
            self.wait_belts_stopped()
            time.sleep(0.25 if self.mode == "vision" else 0.15)  # let perception see the stopped scene
            trays = [t for t in self.trays() if 0.05 < t.x < 0.40 and self.free_pocket(t) is not None]
            cands = [
                c
                for c in self.candidates(fits)
                if xmin < c.x < xmax
                and reachable(c.x, c.y)
                and not c.occluded
                and c.tilt < math.radians(4)
                and blacklist.get(c.key, 0) < now
            ]
            if not trays or not cands:
                self.belts(belt_speed)
                continue
            tray = trays[0]
            pocket = self.free_pocket(tray)
            c = max(cands, key=lambda c: c.x)
            h = PRODUCT_HEIGHT[c.cls]
            if t_start is None:
                t_start = time.monotonic()
            tc = time.monotonic()
            attempts += 1
            parked = False
            pick = [
                seg(MotionSegment.VIA_CART, c.x, c.y, c.top + hover, c.yaw, via_speed=0.5),
                seg(MotionSegment.PTP_CART, c.x, c.y, c.top + 0.001, c.yaw),
            ]
            if not self.run_motion(pick, f"pick {c.key}"):
                blacklist[c.key] = time.monotonic() + 15.0
                self.vacuum(False, 0.0)
                self.run_motion([seg(MotionSegment.PTP_CART, c.x, c.y, c.top + hover, c.yaw)], "retreat")
                self.belts(belt_speed)
                continue
            r = self.vacuum(True, 0.5)
            if not r.sealed:
                self.get_logger().warn(f"no seal on {c.key}")
                blacklist[c.key] = time.monotonic() + 15.0
                self.vacuum(False, 0.1)
                self.run_motion([seg(MotionSegment.PTP_CART, c.x, c.y, c.top + hover, c.yaw)], "retreat")
                continue
            px, py, zf = self.tray.pocket_world((tray.x, tray.y, tray.z), tray.yaw, pocket)
            place_z = zf + h + 0.004
            place = [
                seg(MotionSegment.VIA_CART, c.x, c.y, c.top + hover, c.yaw, via_speed=0.5),
                seg(MotionSegment.VIA_CART, px, py, place_z + hover, tray.yaw, via_speed=0.5),
                seg(MotionSegment.PTP_CART, px, py, place_z, tray.yaw),
            ]
            ok = self.run_motion(place, f"place {c.key} -> {tray.key}[{pocket}]")
            self.vacuum(False, 0.1)
            self.latched[(tray.key, pocket)] = time.monotonic() + 2.0
            self.run_motion([seg(MotionSegment.VIA_CART, px, py, place_z + hover, tray.yaw, via_speed=0.5)], "lift")
            if ok:
                done += 1
                cycle_times.append(time.monotonic() - tc)
                el = time.monotonic() - t_start
                self.get_logger().info(
                    f"cycle {done}: {cycle_times[-1]:.2f} s | {60.0 * done / el:.1f} cpm incl. indexing | mean motion "
                    f"{sum(cycle_times) / len(cycle_times):.2f} s | success {done}/{attempts}"
                )
        self.belts(belt_speed)
        self.get_logger().info(f"finished: {done} cycles, {attempts} attempts, mode={self.mode}")


def main():
    rclpy.init()
    node = RunCycle()
    ex = MultiThreadedExecutor(num_threads=4)
    ex.add_node(node)
    th = threading.Thread(target=ex.spin, daemon=True)
    th.start()
    try:
        node.run()
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
