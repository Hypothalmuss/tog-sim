#!/usr/bin/env python3
"""Generate a pocketed tray SDF model (base plate + pocket walls) from a yaml description.

Usage: gen_tray_model trays.yaml tray_2x4 out_dir
The tray origin is at the bottom face centre; pocket (0,0) is the corner at -x,-y; rows run along +y, cols along +x.
"""
import os
import sys

import yaml

TEMPLATE_HEAD = """<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="{name}">
    <link name="link">
      <inertial>
        <pose>0 0 {cz:.4f} 0 0 0</pose>
        <mass>{mass}</mass>
        <inertia><ixx>{ixx:.6f}</ixx><iyy>{iyy:.6f}</iyy><izz>{izz:.6f}</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
"""
TEMPLATE_TAIL = """    </link>
  </model>
</sdf>
"""


def box(name, x, y, z, sx, sy, sz, color, label):
    vis = f"""      <visual name="{name}_v">
        <pose>{x:.4f} {y:.4f} {z:.4f} 0 0 0</pose>
        <geometry><box><size>{sx:.4f} {sy:.4f} {sz:.4f}</size></box></geometry>
        <material><ambient>{color}</ambient><diffuse>{color}</diffuse></material>
        <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>{label}</label></plugin>
      </visual>
"""
    col = f"""      <collision name="{name}_c">
        <pose>{x:.4f} {y:.4f} {z:.4f} 0 0 0</pose>
        <geometry><box><size>{sx:.4f} {sy:.4f} {sz:.4f}</size></box></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
"""
    return vis + col


def main():
    cfg_path, tray_name, out_dir = sys.argv[1:4]
    cfg = yaml.safe_load(open(cfg_path))["trays"][tray_name]
    rows, cols = cfg["rows"], cfg["cols"]
    px, py = cfg["pitch_x"], cfg["pitch_y"]
    pw, pl, pd = cfg["pocket_x"], cfg["pocket_y"], cfg["pocket_depth"]
    wall = cfg.get("wall", 0.004)
    base_t = cfg.get("base_thickness", 0.004)
    margin = cfg.get("margin", 0.01)
    color = cfg.get("color", "0.85 0.82 0.75 1")
    label = cfg.get("label", 3)
    total_x = cols * px + 2 * margin
    total_y = rows * py + 2 * margin
    mass = cfg.get("mass", 0.25)
    h = base_t + pd
    parts = [TEMPLATE_HEAD.format(name=tray_name, cz=h / 2, mass=mass,
                                  ixx=mass / 12 * (total_y**2 + h**2), iyy=mass / 12 * (total_x**2 + h**2),
                                  izz=mass / 12 * (total_x**2 + total_y**2))]
    # Collision budget matters: every box touching the belt adds contacts, and DART's solver cost grows fast.
    # Only the base plate touches the belt; walls sit ON the base. Pocket opening = pitch - wall.
    parts.append(box("base", 0, 0, base_t / 2, total_x, total_y, base_t, color, label))
    x0 = -cols * px / 2
    y0 = -rows * py / 2
    wall_x = max(wall, px - pw)  # wall thickness along x so that the opening is exactly pocket_x
    wall_y = max(wall, py - pl)
    for c in range(cols + 1):
        x = x0 + c * px
        parts.append(box(f"wx{c}", x, 0, base_t + pd / 2, wall_x, total_y, pd, color, label))
    for r in range(rows + 1):
        y = y0 + r * py
        parts.append(box(f"wy{r}", 0, y, base_t + pd / 2, total_x, wall_y, pd, color, label))
    parts.append(TEMPLATE_TAIL)
    os.makedirs(out_dir, exist_ok=True)
    with open(os.path.join(out_dir, "model.sdf"), "w") as f:
        f.write("".join(parts))
    with open(os.path.join(out_dir, "model.config"), "w") as f:
        f.write(
            f"""<?xml version="1.0"?>
<model>
  <name>{tray_name}</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <author><name>tog-sim</name></author>
  <description>Generated pocket tray {rows}x{cols}, pitch {px}x{py} m, pocket {pw}x{pl}x{pd} m.</description>
</model>
"""
        )
    print(f"wrote {out_dir}/model.sdf ({rows}x{cols}, {total_x:.3f} x {total_y:.3f} m)")


if __name__ == "__main__":
    main()
