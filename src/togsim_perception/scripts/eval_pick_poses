#!/usr/bin/env python3
"""Score vision pick candidates against Gazebo ground truth.

  ros2 run togsim_perception eval_pick_poses --ros-args -p frames:=100 -p use_sim_time:=true

For every /togsim/pick_candidates frame, each candidate is matched (greedy, nearest first) to a GT product whose
origin lies inside the pick-camera region. Reports recall / precision / class accuracy and xy / height / yaw error
statistics, and writes them as JSON (`out` parameter).
"""

import json
import math
import os
import threading
from collections import deque

import numpy as np
import rclpy
from rclpy.node import Node
from tf2_msgs.msg import TFMessage

from togsim_msgs.msg import PickCandidateArray

PRODUCT_H = {"product_bar": 0.0186, "product_carton": 0.025}
SYMMETRIC_YAW = {
    "product_bar": math.pi,
    "product_carton": math.pi,
}  # both are rectangular: yaw is defined modulo 180 deg


def yaw_of(q):
    return math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))


def ang_diff(a, b, period):
    d = (a - b) % period
    return min(d, period - d)


class EvalPickPoses(Node):
    def __init__(self):
        super().__init__("eval_pick_poses")
        self.declare_parameter("frames", 100)
        self.declare_parameter(
            "region", [-0.05, 0.72, -0.50, -0.20]
        )  # x_min x_max y_min y_max (pick camera FOV on the belt)
        self.declare_parameter("match_radius_m", 0.05)
        self.declare_parameter("out", os.path.expanduser("~/togsim_data/eval_pick_poses.json"))
        self.frames = int(self.get_parameter("frames").value)
        self.region = [float(v) for v in self.get_parameter("region").value]
        self.radius = float(self.get_parameter("match_radius_m").value)
        self.lock = threading.Lock()
        self.gt_hist = deque()  # (sim_time_ns, {name: (x, y, z, yaw)})
        self.per_class = {}  # class -> [matched, gt]
        self.n_frames = 0
        self.n_gt = self.n_cand = self.n_match = self.n_cls_ok = self.n_fp = 0
        self.err_xy, self.err_z, self.err_yaw = [], [], []
        self.create_subscription(TFMessage, "/world/cell/pose/info", self.on_gt, 10)
        self.create_subscription(PickCandidateArray, "/togsim/pick_candidates", self.on_cands, 5)
        self.done = threading.Event()

    def on_gt(self, msg):
        """/world/cell/pose/info carries no stamp: tag each snapshot with the node clock (sim time with use_sim_time)."""
        now_ns = self.get_clock().now().nanoseconds
        snap = {}
        for t in msg.transforms:
            n = t.child_frame_id
            if n.startswith("product_"):
                tr = t.transform.translation
                snap[n] = (tr.x, tr.y, tr.z, yaw_of(t.transform.rotation))
        with self.lock:
            self.gt_hist.append((now_ns, snap))
            while len(self.gt_hist) > 1 and now_ns - self.gt_hist[0][0] > 3_000_000_000:
                self.gt_hist.popleft()

    def gt_at(self, stamp_ns):
        """GT poses linearly interpolated between the two snapshots around the candidates' observation stamp (the
        belt moves 10 mm per 100 ms); None when the stamp is outside the 3 s history."""
        with self.lock:
            hist = list(self.gt_hist)
        if not hist or stamp_ns < hist[0][0] - 200_000_000 or stamp_ns > hist[-1][0] + 200_000_000:
            return None
        after = next((i for i, (t, _) in enumerate(hist) if t >= stamp_ns), None)
        if after is None:
            return hist[-1][1]
        if after == 0:
            return hist[0][1]
        (t0, a), (t1, b) = hist[after - 1], hist[after]
        w = (stamp_ns - t0) / max(t1 - t0, 1)
        out = {}
        for n, pa in a.items():
            pb = b.get(n)
            if pb is None:
                continue
            dyaw = (pb[3] - pa[3] + math.pi) % (2 * math.pi) - math.pi
            out[n] = (
                pa[0] + w * (pb[0] - pa[0]),
                pa[1] + w * (pb[1] - pa[1]),
                pa[2] + w * (pb[2] - pa[2]),
                pa[3] + w * dyaw,
            )
        return out

    def gt_class(self, name):
        return "product_" + name.split("_")[1]

    def on_cands(self, msg):
        if self.done.is_set():
            return
        obs = msg.candidates[0].observed if msg.candidates else msg.header.stamp
        obs_ns = obs.sec * 1_000_000_000 + obs.nanosec
        gt_all = self.gt_at(obs_ns)
        if gt_all is None:
            with self.lock:
                last = self.gt_hist[-1][0] if self.gt_hist else None
            last_s = "none" if last is None else f"{last * 1e-9:.2f} s"
            self.get_logger().warn(
                f"no GT history around the candidates' stamp {obs_ns * 1e-9:.2f} s (latest GT {last_s}, "
                f"{len(self.gt_hist)} snapshots) - is /world/cell/pose/info bridged and use_sim_time set?",
                throttle_duration_sec=2.0,
            )
            return
        x0, x1, y0, y1 = self.region
        gts = {n: v for n, v in gt_all.items() if x0 <= v[0] <= x1 and y0 <= v[1] <= y1}
        cands = []
        for c in msg.candidates:
            p = c.grasp_pose.pose.position
            cands.append((p.x, p.y, p.z, math.radians(c.yaw_deg), c.class_name))
        # greedy nearest-first matching against every GT product (so products just outside the region are not FPs)
        pairs = sorted(
            (
                (math.hypot(cx - g[0], cy - g[1]), i, n)
                for i, (cx, cy, *_) in enumerate(cands)
                for n, g in gt_all.items()
            ),
            key=lambda t: t[0],
        )
        used_c, used_g = set(), set()
        for d, i, n in pairs:
            if d > self.radius or i in used_c or n in used_g:
                continue
            used_c.add(i)
            used_g.add(n)
            if n not in gts:
                continue  # matched, but outside the evaluated region: neither a hit nor a miss
            cx, cy, cz, cyaw, ccls = cands[i]
            gx, gy, gz, gyaw = gts[n]
            gcls = self.gt_class(n)
            self.err_xy.append(d)
            self.err_z.append(cz - (gz + PRODUCT_H.get(gcls, 0.0)))
            self.err_yaw.append(math.degrees(ang_diff(cyaw, gyaw, SYMMETRIC_YAW.get(gcls, 2 * math.pi))))
            self.n_cls_ok += ccls == gcls
            self.per_class.setdefault(gcls, [0, 0])[0] += 1
        for n in gts:
            self.per_class.setdefault(self.gt_class(n), [0, 0])[1] += 1
        self.n_frames += 1
        self.n_gt += len(gts)
        self.n_cand += len(cands)
        self.n_match += len(used_g & set(gts))
        self.n_fp += len(cands) - len(used_c)
        if self.n_frames % 10 == 0:
            xy = 1e3 * np.mean(self.err_xy or [0])
            self.get_logger().info(f"{self.n_frames}/{self.frames} frames, recall {self.recall():.2f}, xy {xy:.1f} mm")
        if self.n_frames >= self.frames:
            self.done.set()

    def recall(self):
        return self.n_match / self.n_gt if self.n_gt else 0.0

    def summary(self):
        def stats(v):
            v = np.abs(np.array(v or [0.0]))
            return {"mean": float(v.mean()), "p95": float(np.percentile(v, 95)), "max": float(v.max())}

        return {
            "frames": self.n_frames,
            "gt_products": self.n_gt,
            "candidates": self.n_cand,
            "false_positives": self.n_fp,
            "matched": self.n_match,
            "recall": self.recall(),
            "precision": 1.0 - self.n_fp / self.n_cand if self.n_cand else 0.0,
            "per_class_recall": {k: (m / g if g else 0.0) for k, (m, g) in self.per_class.items()},
            "class_accuracy": self.n_cls_ok / self.n_match if self.n_match else 0.0,
            "xy_error_mm": stats([1e3 * e for e in self.err_xy]),
            "height_error_mm": stats([1e3 * e for e in self.err_z]),
            "yaw_error_deg": stats(self.err_yaw),
        }


def main():
    rclpy.init()
    node = EvalPickPoses()
    th = threading.Thread(target=rclpy.spin, args=(node,), daemon=True)
    th.start()
    try:
        node.done.wait()
    except KeyboardInterrupt:
        pass
    s = node.summary()
    out = os.path.expanduser(node.get_parameter("out").value)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        json.dump(s, f, indent=2)
    print(json.dumps(s, indent=2))
    node.destroy_node()
    rclpy.try_shutdown()


if __name__ == "__main__":
    main()
