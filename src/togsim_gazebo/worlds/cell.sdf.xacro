<?xml version="1.0" ?>
<!--
  tog-sim production cell (Gazebo Fortress). Expanded with xacro at launch time.
  Layout (world frame, floor z = 0, robot pedestal at the origin):
    infeed conveyor  along +x at y = -0.35 : unsorted products travel +x, pick zone around x = 0.35
    outfeed conveyor along +x at y = +0.35 : pocket trays travel +x, place zone around x = 0.35
    belt surface at z = 0.52; one RealSense D435 above each zone at z = 1.62 looking down
-->
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="infeed_speed" default="0.10"/>
  <xacro:arg name="outfeed_speed" default="0.08"/>
  <xacro:arg name="enclosure" default="true"/>
  <xacro:arg name="rtf" default="1.0"/>
  <xacro:arg name="step" default="0.001"/>
  <xacro:arg name="cameras" default="true"/>
  <xacro:arg name="conveyor_visuals" default="true"/>
  <xacro:arg name="segmentation" default="false"/>   <!-- add panoptic segmentation cameras (dataset generation) -->
  <xacro:arg name="cam_width" default="848"/>
  <xacro:arg name="cam_height" default="480"/>
  <xacro:arg name="cam_rate" default="30"/>
  <xacro:property name="belt_z" value="0.52"/>
  <xacro:property name="belt_len" value="2.5"/>
  <xacro:property name="belt_w" value="0.40"/>
  <xacro:property name="cam_z" value="1.62"/>

  <!-- one conveyor: 5 Open-RMF conveyor blocks (visual/structure) + a belt surface driven by togsim::ConveyorSystem -->
  <xacro:macro name="conveyor" params="name y speed">
    <xacro:macro name="block" params="i">
      <include>
        <uri>model://conveyor_block_rmf</uri>
        <name>${name}_block_${i}</name>
        <pose>${-1.0 + 0.5*i} ${y} 0 0 0 0</pose>
      </include>
    </xacro:macro>
    <xacro:if value="$(arg conveyor_visuals)">
      <xacro:block i="0"/><xacro:block i="1"/><xacro:block i="2"/><xacro:block i="3"/><xacro:block i="4"/>
    </xacro:if>
    <model name="${name}">
      <static>true</static>
      <pose>0 ${y} ${belt_z - 0.015} 0 0 0</pose>
      <link name="belt">
        <collision name="belt_collision">
          <geometry><box><size>${belt_len} ${belt_w} 0.03</size></box></geometry>
          <!-- the belt surface itself is (nearly) frictionless: the ConveyorSystem drive force plays the role of
               friction with the moving belt (saturating at max_drive_accel ~ mu*g) -->
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
        <visual name="belt_visual">
          <geometry><box><size>${belt_len} ${belt_w} 0.03</size></box></geometry>
          <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.12 0.12 0.13 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
        </visual>
        <!-- side guides -->
        <visual name="guide_l"><pose>0 ${belt_w/2 + 0.01} 0.03 0 0 0</pose><geometry><box><size>${belt_len} 0.02 0.04</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material></visual>
        <collision name="guide_l_c"><pose>0 ${belt_w/2 + 0.01} 0.03 0 0 0</pose><geometry><box><size>${belt_len} 0.02 0.04</size></box></geometry></collision>
        <visual name="guide_r"><pose>0 ${-belt_w/2 - 0.01} 0.03 0 0 0</pose><geometry><box><size>${belt_len} 0.02 0.04</size></box></geometry>
          <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material></visual>
        <collision name="guide_r_c"><pose>0 ${-belt_w/2 - 0.01} 0.03 0 0 0</pose><geometry><box><size>${belt_len} 0.02 0.04</size></box></geometry></collision>
      </link>
      <plugin filename="togsim_conveyor_system" name="togsim::ConveyorSystem">
        <belt_link>belt</belt_link>
        <surface_size>${belt_len} ${belt_w}</surface_size>
        <surface_offset>0 0 0.015</surface_offset>
        <direction>1 0 0</direction>
        <capture_height>0.10</capture_height>
        <initial_velocity>${speed}</initial_velocity>
        <max_acceleration>1.0</max_acceleration>
        <drive_gain>40.0</drive_gain>
        <max_drive_accel>6.0</max_drive_accel>
        <cmd_topic>/togsim/conveyor/${name}/cmd_vel</cmd_topic>
        <state_topic>/togsim/conveyor/${name}/state</state_topic>
      </plugin>
    </model>
  </xacro:macro>

  <!-- overhead RealSense D435 with an rgbd sensor; looks straight down -->
  <xacro:macro name="overhead_camera" params="name x y">
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} ${cam_z} 0 1.5708 0</pose>
      <link name="link">
        <visual name="body">
          <pose>0 0 0 1.5708 0 1.5708</pose>
          <geometry><mesh><uri>package://realsense2_description/meshes/d435.dae</uri></mesh></geometry>
        </visual>
        <sensor name="rgb" type="camera">
          <always_on>1</always_on>
          <update_rate>$(arg cam_rate)</update_rate>
          <visualize>false</visualize>
          <topic>${name}/image</topic>
          <ignition_frame_id>${name}_optical</ignition_frame_id>
          <camera>
            <horizontal_fov>1.2043</horizontal_fov>
            <image><width>$(arg cam_width)</width><height>$(arg cam_height)</height><format>R8G8B8</format></image>
            <clip><near>0.15</near><far>4.0</far></clip>
          </camera>
        </sensor>
        <xacro:if value="$(arg segmentation)">
          <!-- ground-truth instance labels, co-located with the RGB camera: used ONLY to auto-label training data -->
          <sensor name="seg" type="segmentation">
            <always_on>1</always_on>
            <update_rate>$(arg cam_rate)</update_rate>
            <visualize>false</visualize>
            <topic>${name}/segmentation</topic>
            <ignition_frame_id>${name}_optical</ignition_frame_id>
            <camera>
              <segmentation_type>panoptic</segmentation_type>
              <horizontal_fov>1.2043</horizontal_fov>
              <image><width>$(arg cam_width)</width><height>$(arg cam_height)</height></image>
              <clip><near>0.15</near><far>4.0</far></clip>
            </camera>
          </sensor>
        </xacro:if>
        <sensor name="depth" type="depth_camera">
          <always_on>1</always_on>
          <update_rate>$(arg cam_rate)</update_rate>
          <visualize>false</visualize>
          <topic>${name}/depth_image</topic>
          <ignition_frame_id>${name}_optical</ignition_frame_id>
          <camera>
            <horizontal_fov>1.2043</horizontal_fov>
            <image><width>$(arg cam_width)</width><height>$(arg cam_height)</height><format>R_FLOAT32</format></image>
            <clip><near>0.2</near><far>4.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
    <!-- camera mast -->
    <model name="${name}_mast">
      <static>true</static>
      <pose>${x} ${y + 0.25} 0 0 0 0</pose>
      <link name="link">
        <visual name="post"><pose>0 0 ${(cam_z+0.05)/2} 0 0 0</pose><geometry><box><size>0.04 0.04 ${cam_z+0.05}</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
        <visual name="arm"><pose>0 -0.125 ${cam_z+0.04} 0 0 0</pose><geometry><box><size>0.03 0.25 0.03</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
      </link>
    </model>
  </xacro:macro>

  <world name="cell">
    <physics name="fast" type="dart">
      <max_step_size>$(arg step)</max_step_size>
      <real_time_factor>$(arg rtf)</real_time_factor>
      <!-- PGS is 2-3x faster than Dantzig with many box contacts (products on belts) -->
      <dart><solver><solver_type>pgs</solver_type></solver></dart>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="lamp_pick">
      <pose>0.35 -0.35 2.2 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>6</range><constant>0.6</constant><linear>0.1</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light type="point" name="lamp_place">
      <pose>0.35 0.35 2.2 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>6</range><constant>0.6</constant><linear>0.1</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <xacro:if value="$(arg enclosure)">
      <include>
        <uri>model://enclosure_rmf</uri>
        <name>enclosure</name>
        <pose>0 0 0 0 0 0</pose>
      </include>
    </xacro:if>

    <xacro:conveyor name="infeed" y="-0.35" speed="$(arg infeed_speed)"/>
    <xacro:conveyor name="outfeed" y="0.35" speed="$(arg outfeed_speed)"/>
    <xacro:if value="$(arg cameras)">
      <xacro:overhead_camera name="cam_pick" x="0.35" y="-0.35"/>
      <xacro:overhead_camera name="cam_place" x="0.35" y="0.35"/>
    </xacro:if>
  </world>
</sdf>
