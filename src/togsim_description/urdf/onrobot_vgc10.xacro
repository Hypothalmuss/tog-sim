<?xml version="1.0"?>
<!--
  OnRobot VGC10 (single 40 mm cup) — meshes from UOsaka-Harada-Laboratory/onrobot (MIT).
  Mesh frame: +z points from the mounting flange towards the cup. We mount it "hanging" (z down) via a 180° flip.
  Cup face is at z = 0.0949 + 0.0843 = 0.1792 m from the mounting flange.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="vgc10_cup_offset"  value="0.094901"/>
  <xacro:property name="vgc10_cup_length"  value="0.0843"/>
  <xacro:property name="vgc10_cup_radius"  value="0.020"/>

  <xacro:macro name="onrobot_vgc10" params="prefix:='' parent mesh_pkg:='togsim_description'">
    <xacro:property name="M" value="package://${mesh_pkg}/meshes/onrobot_vgc10"/>
    <joint name="${prefix}vgc10_mount_joint" type="fixed">
      <!-- flip so the gripper hangs down from the tool mount -->
      <origin xyz="0 0 0" rpy="${pi} 0 0"/>
      <parent link="${parent}"/>
      <child link="${prefix}vgc10_base_link"/>
    </joint>
    <link name="${prefix}vgc10_base_link">
      <visual>
        <geometry><mesh filename="${M}/visual/base_link_1cup.stl"/></geometry>
        <material name="vgc10_grey"><color rgba="0.8 0.8 0.8 1"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="${M}/collision/base_link_1cup.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.6"/>
        <inertia ixx="8e-4" ixy="0" ixz="0" iyy="8e-4" iyz="0" izz="6e-4"/>
      </inertial>
    </link>
    <joint name="${prefix}vgc10_suction_joint" type="fixed">
      <origin xyz="0 0 ${vgc10_cup_offset}" rpy="0 0 0"/>
      <parent link="${prefix}vgc10_base_link"/>
      <child link="${prefix}vgc10_suction"/>
    </joint>
    <link name="${prefix}vgc10_suction">
      <visual>
        <geometry><mesh filename="${M}/visual/suction_cup_1cup.stl"/></geometry>
        <material name="vgc10_black"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <!-- simple cylinder collision: fast, stable contacts for the contact-based vacuum seal -->
      <collision>
        <origin xyz="0 0 ${vgc10_cup_length/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${vgc10_cup_radius}" length="${vgc10_cup_length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="1.5e-4" ixy="0" ixz="0" iyy="1.5e-4" iyz="0" izz="5e-5"/>
      </inertial>
    </link>
    <!-- TCP: centre of the cup face, z pointing OUT of the cup (approach direction = -z of tool_mount) -->
    <joint name="${prefix}tcp_joint" type="fixed">
      <origin xyz="0 0 ${vgc10_cup_length}" rpy="0 0 0"/>
      <parent link="${prefix}vgc10_suction"/>
      <child link="${prefix}tcp"/>
    </joint>
    <link name="${prefix}tcp"/>

    <!-- Gazebo: keep the cup link separate (no fixed-joint lumping) and attach a contact sensor to its collision -->
    <gazebo reference="${prefix}vgc10_suction_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
    <gazebo reference="${prefix}vgc10_suction">
      <sensor name="${prefix}cup_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>500</update_rate>
        <contact>
          <collision>${prefix}vgc10_suction_collision</collision>
        </contact>
      </sensor>
      <collision>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          <contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>
</robot>
