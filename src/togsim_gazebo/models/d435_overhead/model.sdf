<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="d435_overhead">
    <static>true</static>
    <link name="camera_link">
      <visual name="body">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>package://realsense2_description/meshes/d435.dae</uri></mesh></geometry>
      </visual>
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>rgbd</topic>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>  <!-- D435 RGB 69 deg -->
          <image><width>848</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.15</near><far>4.0</far></clip>
          <depth_camera><clip><near>0.2</near><far>4.0</far></clip></depth_camera>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
