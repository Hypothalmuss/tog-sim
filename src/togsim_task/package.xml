<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>togsim_task</name>
  <version>0.1.0</version>
  <description>Lifecycle FSM, pick-and-place behaviour tree, KPIs and benchmarks for tog-sim.</description>
  <maintainer email="mohamednadimtouil@gmail.com">Mohamed Nadim Touil</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>py_trees_ros</depend>
  <depend>togsim_msgs</depend>
  <depend>togsim_motion</depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
