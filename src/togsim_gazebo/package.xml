<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>togsim_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Fortress world, models and system plugins (conveyor, vacuum gripper) for tog-sim.</description>
  <maintainer email="mohamednadimtouil@gmail.com">Mohamed Nadim Touil</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>ignition-gazebo6</depend>
  <depend>ignition-plugin</depend>
  <depend>ignition-transport11</depend>
  <depend>ignition-msgs8</depend>
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>togsim_msgs</depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>togsim_description</exec_depend>
  <exec_depend>togsim_control</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
