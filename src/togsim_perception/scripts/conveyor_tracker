#!/usr/bin/env python3
"""Stable, velocity-extrapolated tracks of products and trays on the belts, as TF frames and topics.

  ros2 run togsim_perception conveyor_tracker --ros-args -p use_sim_time:=true [-p source:=vision|gt]

Inputs (vision): /togsim/pick_candidates (PickCandidateArray), /togsim/tray_state (TrayState)
Inputs (gt):     /world/cell/pose/info (TFMessage) + belt encoders
Outputs: TF  world -> prod_<id> (product top, z up, yaw = long axis) and world -> tray_<id> (tray origin),
         /togsim/tracks/products (PickCandidateArray, ids stable, poses predicted to `now`),
         /togsim/tracks/trays (TrayState, tray_id stable, pose predicted to `now`).
The motion server's TRACK_CART segments follow these frames (re-targeted every tick).
"""

import math
import threading

import rclpy
import yaml
from ament_index_python.packages import get_package_share_directory
from geometry_msgs.msg import PoseStamped, TransformStamped
from rclpy.node import Node
from std_msgs.msg import Float64
from tf2_msgs.msg import TFMessage
from rclpy.time import Time
from tf2_ros import Buffer, TransformBroadcaster, TransformListener

from togsim_msgs.msg import PickCandidate, PickCandidateArray, TrayState
from togsim_perception.tracking import BeltTracker, Observation
from togsim_task.trays import TraySpec

PRODUCT_H = {"product_bar": 0.0186, "product_carton": 0.025}


def yaw_of(q):
    return math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))


def tilt_of(q):
    return math.acos(max(-1.0, min(1.0, 1.0 - 2.0 * (q.x * q.x + q.y * q.y))))


class ConveyorTracker(Node):
    def __init__(self):
        super().__init__("conveyor_tracker")
        self.declare_parameter("source", "vision")
        self.declare_parameter("rate", 100.0)
        self.declare_parameter("gate_m", 0.06)
        self.declare_parameter("lost_s", 2.5)  # a product is hidden under the arm for most of its pick
        self.declare_parameter("tray_lost_s", 4.0)  # trays are occluded by the arm during a place: predict through it
        self.declare_parameter("mature_alpha", 0.25)
        self.declare_parameter("tool_frame", "tcp")  # observations near the tool are hidden/biased by the arm: ignored
        # vision observations trail ground truth by ~3 mm at 0.09 m/s (eval_tray_state by_x): capture-to-stamp latency
        self.declare_parameter("latency_s", 0.03)
        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self)
        self.tool_warned = False
        self.declare_parameter("tray_model", "tray_2x4")
        self.declare_parameter("world_frame", "world")
        self.source = self.get_parameter("source").value
        self.world = self.get_parameter("world_frame").value
        gate, lost = float(self.get_parameter("gate_m").value), float(self.get_parameter("lost_s").value)
        self.products = BeltTracker(gate_m=gate, lost_s=lost, yaw_period=math.pi)
        tray_lost = float(self.get_parameter("tray_lost_s").value)
        mature = float(self.get_parameter("mature_alpha").value)
        # trays ride the belt along x; their speed comes from the shared belt-speed estimate (never a per-track lateral
        # velocity: one drifted a hidden tray's frame by 100+ mm during a place)
        # trays ride straight at the shared belt speed: once a track is settled it is dead-reckoned on the belt model
        # and single observations barely move it (an arm-shadowed mask accepted just before the under-arm gate
        # shifted frames by 5-10 mm); products keep the normal weight (they are tracked for a second or two)
        self.trays = BeltTracker(
            gate_m=gate,
            lost_s=tray_lost,
            yaw_period=math.pi,
            mature_alpha=mature,
            lateral_alpha_mature=0.05,
            settled_alpha=0.05,
            settled_after=20,
        )  # the pocket grid is 180 deg symmetric; 0.6 -> 0.25 -> 0.05 over the first two seconds in view
        cfg = yaml.safe_load(open(f"{get_package_share_directory('togsim_gazebo')}/config/trays.yaml"))
        self.tray = TraySpec.from_yaml(cfg, self.get_parameter("tray_model").value)
        self.lock = threading.Lock()
        self.belt_v = {"infeed": 0.0, "outfeed": 0.0}
        for b in ("infeed", "outfeed"):
            self.create_subscription(
                Float64, f"/togsim/conveyor/{b}/state", lambda m, b=b: self.belt_v.__setitem__(b, m.data), 10
            )
        if self.source == "gt":
            self.create_subscription(TFMessage, "/world/cell/pose/info", self.on_gt, 10)
        else:
            self.create_subscription(PickCandidateArray, "/togsim/pick_candidates", self.on_cands, 5)
            self.create_subscription(TrayState, "/togsim/tray_state", self.on_tray, 10)
        self.tf = TransformBroadcaster(self)
        self.pub_p = self.create_publisher(PickCandidateArray, "/togsim/tracks/products", 5)
        self.pub_t = self.create_publisher(TrayState, "/togsim/tracks/trays", 10)
        self.seq = 0
        self.create_timer(1.0 / float(self.get_parameter("rate").value), self.publish)
        self.get_logger().info(f"conveyor_tracker ready (source={self.source})")

    # ---------------- inputs ----------------
    def _t(self, stamp):
        return stamp.sec + stamp.nanosec * 1e-9 - float(self.get_parameter("latency_s").value)

    def on_cands(self, msg):
        obs = []
        tool = self.tool_xy()
        for c in msg.candidates:
            p = c.grasp_pose.pose.position
            if not (0.4 < p.z < 0.7):
                continue  # a grasp pose off the belt plane (missing depth) would drag the track's height
            if tool is not None and math.hypot(p.x - tool[0], p.y - tool[1]) < 0.12:
                continue  # under the arm: hidden or biased

            obs.append(
                Observation(
                    p.x,
                    p.y,
                    p.z,
                    math.radians(c.yaw_deg),
                    c.class_name,
                    self._t(c.observed),
                    vx=c.belt_velocity.x,
                    vy=c.belt_velocity.y,
                    payload=c,
                    area=float(c.mask_area_px),
                )
            )
        with self.lock:
            self.products.update(obs, t_now=self._t(msg.header.stamp))

    def tool_xy(self):
        """World xy of the tool (None if the robot TF is not available)."""
        try:
            tf = self.tf_buffer.lookup_transform(self.world, self.get_parameter("tool_frame").value, Time())
            return tf.transform.translation.x, tf.transform.translation.y
        except Exception as e:  # noqa: BLE001
            if not self.tool_warned:
                self.tool_warned = True
                self.get_logger().warn(f"no tool TF, observations under the arm are not filtered: {e}")
            return None

    def on_tray(self, msg):
        if not msg.tracked:
            return  # partial / unreliable observation: never create or drag a track with it
        p = msg.pose.pose.position
        tool = self.tool_xy()
        # the arm hides/biases a tray while the tool is above the tray or the forearm reaches over it (the forearm
        # occludes the tray well before the tool does; a biased observation then shifts the frame by ~15 mm right
        # before the observations stop). 0.30 x 0.20 m around the tool: the next tray, 0.5 m behind, keeps its early
        # observations even while the trailing pocket of the previous one is being filled (0.40 starved it).
        if tool is not None and abs(p.x - tool[0]) < 0.30 and abs(p.y - tool[1]) < 0.20:
            self.get_logger().info(
                f"tray obs tray{msg.tray_id} gated: tool ({p.x - tool[0]:+.2f},{p.y - tool[1]:+.2f}) m away",
                throttle_duration_sec=1.0,
            )
            return  # the arm is over the tray: the mask/lattice are biased, keep predicting
        o = Observation(
            p.x,
            p.y,
            p.z,
            yaw_of(msg.pose.pose.orientation),
            "tray",
            self._t(msg.header.stamp),
            vx=msg.velocity.x,
            vy=msg.velocity.y,
            key=f"tray{msg.tray_id}",
            payload=msg,
            area=1.0 if msg.tracked else 0.1,
        )
        with self.lock:
            before = {tr.id: (tr.x, tr.y) for tr in self.trays.predict(o.t)}
            for tid, (x, y) in before.items():
                if self.trays.tracks[tid].key == o.key and math.hypot(o.x - x, o.y - y) > 0.03:
                    self.get_logger().warn(
                        f"tray obs {o.key} jumps {1e3 * math.hypot(o.x - x, o.y - y):.0f} mm from track {tid}:"
                        f" obs ({o.x:.3f},{o.y:.3f}) track ({x:.3f},{y:.3f}) t {o.t:.2f}"
                    )
            touched = self.trays.update([o])
            for tr in touched:
                if tr.n_obs == 1:
                    self.get_logger().info(
                        f"tray track {tr.id} created at ({tr.x:.3f},{tr.y:.3f}) key {tr.key} t {o.t:.2f}"
                    )
            for tid in before:
                if tid not in self.trays.tracks:
                    self.get_logger().info(f"tray track {tid} pruned at t {o.t:.2f}")

    def on_gt(self, msg):
        t = self.get_clock().now().nanoseconds * 1e-9  # pose/info carries no stamp
        prods, trays = [], []
        for tr in msg.transforms:
            n = tr.child_frame_id
            p, q = tr.transform.translation, tr.transform.rotation
            if n.startswith("product_"):
                cls = "product_" + n.split("_")[1]
                vx = self.belt_v["infeed"] if p.y < 0 else self.belt_v["outfeed"]
                prods.append(
                    Observation(
                        p.x, p.y, p.z + PRODUCT_H.get(cls, 0.0), yaw_of(q), cls, t, vx=vx, key=n, payload=(tilt_of(q),)
                    )
                )
            elif n.startswith("tray_"):
                trays.append(
                    Observation(p.x, p.y, p.z, yaw_of(q), "tray", t, vx=self.belt_v["outfeed"], key=n, payload=None)
                )
        with self.lock:
            self.products.update(prods, t_now=t)
            self.trays.update(trays, t_now=t)
            if self.source == "gt":  # pocket occupancy from the product poses
                self._gt_occupancy(prods, trays)

    def _gt_occupancy(self, prods, trays):
        self.gt_occ = {}
        for tr in trays:
            occ = [False] * self.tray.n_pockets
            for p in prods:
                if abs(p.z - PRODUCT_H.get(p.cls, 0.0) - tr.z) < 0.06:
                    idx = self.tray.pocket_of_point((tr.x, tr.y, tr.z), tr.yaw, p.x, p.y)
                    if idx is not None:
                        occ[idx] = True
            self.gt_occ[tr.key] = occ

    # ---------------- outputs ----------------
    def publish(self):
        now = self.get_clock().now()
        t = now.nanoseconds * 1e-9
        with self.lock:
            prods = self.products.predict(t)
            trays = self.trays.predict(t)
            gt_occ = dict(getattr(self, "gt_occ", {}))
        tfs = []
        arr = PickCandidateArray()
        arr.header.stamp = now.to_msg()
        arr.header.frame_id = self.world
        self.seq += 1
        arr.frame_seq = self.seq
        for tr in prods:
            if tr.n_obs < 2 and self.source != "gt":
                continue  # wait for a confirmation frame before exposing a track
            tfs.append(self._tf(now, f"prod_{tr.id}", tr.x, tr.y, tr.z, tr.yaw))
            c = PickCandidate()
            if isinstance(tr.payload, PickCandidate):
                c = PickCandidate()
                c.tilt_deg, c.suction_margin_mm, c.occluded, c.score, c.mask_area_px = (
                    tr.payload.tilt_deg,
                    tr.payload.suction_margin_mm,
                    tr.payload.occluded,
                    tr.payload.score,
                    tr.payload.mask_area_px,
                )
                c.centre_offset = tr.payload.centre_offset
                # not pickable while only predicted (the product may be gone: a picked product's track lives on for
                # lost_s) or before the heading/position have settled on a few observations
                if tr.age(t) > 0.4 or tr.n_obs < 4:
                    c.occluded = True
            elif isinstance(tr.payload, tuple):  # gt: (tilt,)
                c.tilt_deg = float(math.degrees(tr.payload[0]))
                c.score = 1.0
            c.header = arr.header
            c.id = tr.id
            c.class_name = tr.cls
            c.grasp_pose = PoseStamped()
            c.grasp_pose.header = arr.header
            c.grasp_pose.pose.position.x, c.grasp_pose.pose.position.y, c.grasp_pose.pose.position.z = tr.x, tr.y, tr.z
            c.grasp_pose.pose.orientation.z, c.grasp_pose.pose.orientation.w = (
                math.sin(tr.yaw / 2),
                math.cos(tr.yaw / 2),
            )
            c.yaw_deg = float(math.degrees(tr.yaw))
            c.height_m = tr.z
            c.belt_velocity.x, c.belt_velocity.y = tr.vx, tr.vy
            c.observed = now.to_msg()
            arr.candidates.append(c)
        self.pub_p.publish(arr)
        if t - getattr(self, "_dump_t", 0.0) > 1.0:
            self._dump_t = t
            pubs = getattr(self, "_pub_counts", {})
            self.get_logger().info(
                "tray tracks: "
                + "; ".join(
                    f"{tr.id}/{tr.key} ({tr.x:.3f},{tr.y:.3f}) n={tr.n_obs} age={tr.age(t):.1f} v={tr.vx:.3f}"
                    f" pub={pubs.get(tr.id, 0)}"
                    for tr in trays
                )
                + f" | belt_vx={self.trays.belt_vx}"
            )
            self._pub_counts = {}
        for tr in trays:
            tfs.append(self._tf(now, f"tray_{tr.id}", tr.x, tr.y, tr.z, tr.yaw))
            if tr.n_obs < 10 and self.source != "gt":
                continue  # not placeable yet: still converging from the lagging first observations at the view entry
            m = TrayState()
            if isinstance(tr.payload, TrayState):
                m.occupied, m.confidence, m.tracked = tr.payload.occupied, tr.payload.confidence, tr.payload.tracked
            else:
                m.occupied = gt_occ.get(tr.key, [False] * self.tray.n_pockets)
                m.confidence = [1.0] * len(m.occupied)
                m.tracked = True
            m.header = arr.header
            m.tray_id = tr.id
            m.pose = PoseStamped()
            m.pose.header = arr.header
            m.pose.pose.position.x, m.pose.pose.position.y, m.pose.pose.position.z = tr.x, tr.y, tr.z
            m.pose.pose.orientation.z, m.pose.pose.orientation.w = math.sin(tr.yaw / 2), math.cos(tr.yaw / 2)
            m.velocity.x, m.velocity.y = tr.vx, tr.vy
            m.rows, m.cols = self.tray.rows, self.tray.cols
            m.pitch_x, m.pitch_y = float(self.tray.pitch_x), float(self.tray.pitch_y)
            self.pub_t.publish(m)
            pc = getattr(self, "_pub_counts", None)
            if pc is None:
                pc = self._pub_counts = {}
            pc[tr.id] = pc.get(tr.id, 0) + 1
        if tfs:
            self.tf.sendTransform(tfs)

    def _tf(self, now, child, x, y, z, yaw):
        t = TransformStamped()
        t.header.stamp = now.to_msg()
        t.header.frame_id = self.world
        t.child_frame_id = child
        t.transform.translation.x, t.transform.translation.y, t.transform.translation.z = float(x), float(y), float(z)
        t.transform.rotation.z, t.transform.rotation.w = math.sin(yaw / 2), math.cos(yaw / 2)
        return t


def main():
    rclpy.init()
    node = ConveyorTracker()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        rclpy.try_shutdown()
        node.destroy_node()


if __name__ == "__main__":
    main()
